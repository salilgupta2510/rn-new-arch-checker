{
  "name": "rn-new-arch-checker",
  "version": "0.1.1",
  "description": "CLI to check if your React Native dependencies support the New Architecture (Fabric + TurboModules). Scan package.json, find migration blockers, gate CI. Run with npx.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "rn-new-arch-checker": "lib/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "start": "node lib/cli.js"
  },
  "keywords": [
    "react-native",
    "new-architecture",
    "fabric",
    "turbomodules",
    "migration",
    "cli",
    "audit",
    "compatibility",
    "new-arch",
    "bridgeless",
    "react-native-new-architecture",
    "new-architecture-compatibility",
    "fabric-compatibility",
    "turbomodule",
    "react-native-directory",
    "dependency-checker",
    "upgrade",
    "react-native-upgrade",
    "expo",
    "npx",
    "ci"
  ],
  "author": "Salil Gupta",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "ora": "^5.4.1",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/node-fetch": "^2.6.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "lib",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salilgupta2510/rn-new-arch-checker.git"
  },
  "homepage": "https://github.com/salilgupta2510/rn-new-arch-checker#readme",
  "bugs": {
    "url": "https://github.com/salilgupta2510/rn-new-arch-checker/issues"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
